# Copy to .env and adjust. Everything is optional for a first start.

# --- Basics ---------------------------------------------------------------
# Absolute path of the inbox folder on THIS machine (forward slashes are fine).
# Docker mounts it to /inbox; Claude saves videos here and attaches them by path.
INBOX_HOST_PATH=C:/Development/power-poster/inbox

# Encrypts platform tokens. Generated automatically into the data folder if empty.
# To set your own: docker compose run --rm powerposter keygen
POWERPOSTER_SECRET_KEY=

# Port of the web UI / MCP endpoint on this machine.
PP_PORT=4000

# --- Platforms (needed to connect accounts and publish) --------------------
# ngrok (free static domain from dashboard.ngrok.com → Domains). When set, PowerPoster starts
# ngrok itself (native run) and uses https://<NGROK_DOMAIN> as PUBLIC_BASE_URL.
NGROK_DOMAIN=
# Only needed for Docker (`docker compose --profile ngrok up -d`); native runs use `ngrok config add-authtoken`.
NGROK_AUTHTOKEN=

# Operator name and contact e-mail on the public /terms and /privacy pages
# (the TikTok and Meta app forms ask for these URLs).
PP_LEGAL_OPERATOR=
PP_LEGAL_CONTACT=

# Alternatively: any other HTTPS tunnel (e.g. Cloudflare). OAuth redirect URIs are <PUBLIC_BASE_URL>/oauth/<platform>/callback
PUBLIC_BASE_URL=
TUNNEL_TOKEN=

# Meta app with "Instagram API with Instagram Login"
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok developer app with Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google Cloud OAuth client (Web application) with the YouTube Data API v3 enabled
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Discord connects per project with a channel webhook URL (Settings → Connections), no app needed.
# Upload limit of your server: 10 (no boost), 50 (boost level 2) or 100 (level 3). Videos are compressed to fit.
DISCORD_MAX_UPLOAD_MB=10

# --- Media ---------------------------------------------------------------
# libx264 (CPU) or h264_nvenc (NVIDIA GPU, use compose.gpu.yaml in Docker)
FFMPEG_ENCODER=libx264
MAX_PARALLEL_ENCODES=1
